{
  "name": "pi-lesson",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "studio": "remotion studio src/index.tsx",
    "check": "tsc --noEmit",
    "render": "remotion render src/index.tsx PiLesson out/pi-lesson.mp4 --gl=angle --concurrency=8",
    "render:master": "npm run render && ffmpeg -y -i out/pi-lesson.mp4 -c:v copy -af loudnorm=I=-16:TP=-1.5:LRA=11 out/pi-lesson-master.mp4",
    "render:ch": "remotion render src/index.tsx"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.535",
    "@remotion/media": "^4.0.535",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.535"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
