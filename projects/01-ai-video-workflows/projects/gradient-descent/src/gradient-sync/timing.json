  "captions": [
    {
      "frame": 2,
      "text": "AI 学习，到底在改什么？"
    },
    {
      "frame": 77,
      "text": "把两个参数，画成一张地图"
    },
    {
      "frame": 146,
      "text": "位置代表参数，高度代表误差"
    },
    {
      "frame": 230,
      "text": "根据当前位置的坡度"
    },
    {
      "frame": 278,
      "text": "朝误差减小的方向，调整一步"
    },
    {
      "frame": 343,
      "text": "再计算，再调整"
    },
    {
      "frame": 389,
      "text": "这就是梯度下降"
    },
    {
      "frame": 432,
      "text": "步子也有讲究"
    },
    {
      "frame": 466,
      "text": "太小，走得慢"
    },
    {
      "frame": 508,
      "text": "太大，可能来回跳"
    },
    {
      "frame": 558,
      "text": "换回合适的步长"
    },
    {
      "frame": 599,
      "text": "更稳地降低误差"
    },
    {
      "frame": 642,
      "text": "这是两参数示意，真实模型维度更高"
    },
    {
      "frame": 729,
      "text": "球表示参数位置，不是自己滚下山"
    }
  ],
