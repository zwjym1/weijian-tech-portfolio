{
  "name": "tesla-roadster-short",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "studio": "remotion studio src/index.tsx",
    "check": "tsc --noEmit",
    "stills": "node scripts/render-stills.mjs",
    "preview:scrub": "remotion render src/index.tsx RoadsterShort out/scrub-preview.mp4 --scale=0.5 --crf=28 --concurrency=2 --gl=angle --muted=false",
    "render:master": "node scripts/master.mjs render:master",
    "align": "node align/server.mjs",
    "studio:v3": "remotion studio src/index.tsx",
    "preview:scrub:v3": "remotion render src/index.tsx RoadsterShortV3 out/v3-raw.mp4 --scale=0.5 --crf=28 --gl=angle && python scripts/mix_v3.py out/v3-raw.mp4 out/scrub-preview-v3.mp4",
    "remix-audio": "node scripts/master.mjs remix-audio"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@remotion/cli": "^4.0.535",
    "@remotion/media": "^4.0.535",
    "@remotion/three": "^4.0.535",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.535",
    "three": "^0.186.1",
    "@remotion/player": "^4.0.535"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "esbuild": "^0.28.1"
  }
}
